# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mariadb://localhost:3306/planit_user_db
SPRING_DATASOURCE_USERNAME=planit_user
SPRING_DATASOURCE_PASSWORD=planit_password

# Redis Configuration
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-secret-key-at-least-256-bits-long-change-this-in-production
JWT_ACCESS_TOKEN_VALIDITY=900000
JWT_REFRESH_TOKEN_VALIDITY=604800000

# AWS Configuration
AWS_REGION=ap-northeast-2
AWS_COGNITO_USER_POOL_ID=your-cognito-user-pool-id
AWS_CREDENTIALS_ACCESS_KEY=your-aws-access-key
AWS_CREDENTIALS_SECRET_KEY=your-aws-secret-key

# Server Configuration
SERVER_PORT=8080
GRPC_SERVER_PORT=9090

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
